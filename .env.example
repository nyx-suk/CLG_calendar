# College Allowed Domain for Google OAuth (Phase 1)
ALLOWED_EMAIL_DOMAIN="college.edu"

# Bootstrap Coordinator Emails allowlist (comma-separated)
COORDINATOR_EMAILS="coordinator.patil@college.edu"

# Google OAuth Credentials (Phase 1)
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# Demo persona switcher flag (only active in development when true)
DEMO_MODE="false"
