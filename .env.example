# Database Connection (SQLite)
DATABASE_URL="file:./dev.db"

# Optional GitHub API Token (increases rate limit for project commit verification)
GITHUB_TOKEN=""

# Auth.js / NextAuth Secret (generate with `openssl rand -base64 32`)
AUTH_SECRET=""

# College Allowed Domain for Google OAuth (Phase 1)
ALLOWED_EMAIL_DOMAIN="college.edu"

# Bootstrap Coordinator Emails allowlist (comma-separated)
COORDINATOR_EMAILS="coordinator.patil@college.edu"

# Google OAuth Credentials (Phase 1)
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# Demo persona switcher flag (only active in development when true)
DEMO_MODE="false"

# Storage Configuration ("local" for development, "s3" for production R2/S3)
STORAGE_PROVIDER="local"
S3_BUCKET=""
S3_ENDPOINT=""
S3_REGION="us-east-1"
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""

# Email Notifications via Resend (Phase 2)
RESEND_API_KEY=""
RESEND_FROM_EMAIL="CampusFlow Notifications <notifications@college.edu>"
